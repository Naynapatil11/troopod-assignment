{{ 'section-combos.css' | asset_url | stylesheet_tag }}

<div class="combos-section" data-section-id="{{ section.id }}" role="region" aria-label="Best selling combos">
  <div class="combos-header">
    {% if section.settings.heading != blank %}
      <h2 class="combos-title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="combos-subtitle">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="combos-grid">
    {% for block in section.blocks %}
      <div class="combo-card" data-combo-id="{{ block.id }}">
        <div class="combo-image">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" 
                 alt="{{ block.settings.title | escape }}"
                 loading="lazy"
                 width="400"
                 height="400">
          {% else %}
            <div class="combo-placeholder">
              <span>🔄</span>
            </div>
          {% endif %}
          <span class="combo-savings">Save {{ block.settings.savings_percent }}%</span>
        </div>
        
        <div class="combo-content">
          <h3 class="combo-title">{{ block.settings.title | default: 'Combo Deal' }}</h3>
          <p class="combo-description">{{ block.settings.description }}</p>
          
          <div class="combo-products">
            {% for i in (1..3) %}
              {% assign product_handle = block.settings['product_' | append: i] %}
              {% if product_handle != blank %}
                {% assign product = all_products[product_handle] %}
                {% if product %}
                  <div class="combo-product-item">
                    <img src="{{ product.featured_image | img_url: '100x100', crop: 'center' }}" 
                         alt="{{ product.title | escape }}"
                         loading="lazy"
                         width="40"
                         height="40">
                    <span>{{ product.title | truncate: 20 }}</span>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          
          <div class="combo-pricing">
            <span class="combo-original-price">{{ block.settings.original_price | money }}</span>
            <span class="combo-sale-price">{{ block.settings.sale_price | money }}</span>
          </div>
          
          <a href="{{ block.settings.button_url | default: '/collections/all' }}" 
             class="combo-btn">
            {{ block.settings.button_text | default: 'Add to Cart' }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    {% else %}
      <div class="empty-state">
        <p>Add combo blocks to display them here.</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Best-Selling Combos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best-Selling Combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Save more with our popular bundles"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Deal",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Combo Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title",
          "default": "Complete Home Care Set"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Everything you need for a clean home"
        },
        {
          "type": "range",
          "id": "savings_percent",
          "label": "Savings Percentage",
          "min": 5,
          "max": 50,
          "step": 5,
          "default": 20
        },
        {
          "type": "header",
          "content": "Products in Combo"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "original_price",
          "label": "Original Price",
          "default": "149.99",
          "info": "Enter as number without currency symbol"
        },
        {
          "type": "text",
          "id": "sale_price",
          "label": "Sale Price",
          "default": "119.99",
          "info": "Enter as number without currency symbol"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Add to Cart"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link",
          "default": "/cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-Selling Combos",
      "category": "Custom",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
