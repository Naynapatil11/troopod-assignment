
{{ 'section-product-grid.css' | asset_url | stylesheet_tag }}

<div class="product-grid-section" data-section-id="{{ section.id }}" role="region" aria-label="Product grid">
  <div class="section-header">
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <p class="section-description">{{ section.settings.description }}</p>
    {% endif %}
    
    {% if section.settings.show_view_all %}
      <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="view-all-link">
        {{ section.settings.view_all_text | default: 'View All' }}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="product-grid" role="list">
    {% assign products = collections[section.settings.collection].products %}
    
    {% if products.size == 0 %}
      <div class="empty-state">
        <p>Add products to this collection to display them here.</p>
      </div>
    {% else %}
      {% for product in products limit: section.settings.products_limit %}
        {% render 'product-card', 
          product: product,
          card_style: section.settings.card_style,
          show_quick_add: section.settings.show_quick_add
        %}
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.show_load_more and products.size > section.settings.products_limit %}
    <div class="load-more-wrapper">
      <button class="load-more-btn" data-load-more>
        Load More Products
      </button>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product Grid (Premium)",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Favorites"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Clean, plant-based products for every home"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "featured", "label": "Featured (with badge)" }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All Link"
    },
    {
      "type": "checkbox",
      "id": "show_load_more",
      "label": "Show Load More Button",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product Grid (Premium)",
      "category": "Custom"
    }
  ]
}
{% endschema %}
