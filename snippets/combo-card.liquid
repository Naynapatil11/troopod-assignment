{%- assign product = product -%}
{%- assign card_style = card_style | default: 'standard' -%}
{%- assign show_quick_add = show_quick_add | default: true -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

{%- assign sold_out = false -%}
{%- unless product.available -%}
  {%- assign sold_out = true -%}
{%- endunless -%}

<a href="{{ product.url }}" 
   class="product-card" 
   role="listitem"
   data-product-id="{{ product.id }}"
   aria-label="{{ product.title | escape }}">
  
  <div class="product-card-image">
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" 
        srcset="{{ product.featured_image | img_url: '400x400' }} 400w,
                {{ product.featured_image | img_url: '600x600' }} 600w,
                {{ product.featured_image | img_url: '800x800' }} 800w"
        sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 25vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="400"
        height="400"
        decoding="async"
      >
    {% else %}
      <div class="no-image-placeholder" role="img" aria-label="No image available">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        <span>No Image</span>
      </div>
    {% endif %}

    <div class="product-badge">
      {% if sold_out %}
        <span class="badge badge-sold-out">Sold Out</span>
      {% elsif on_sale %}
        <span class="badge badge-sale">Sale</span>
      {% elsif product.tags contains 'new' %}
        <span class="badge badge-new">New</span>
      {% elsif product.tags contains 'best-seller' %}
        <span class="badge badge-best-seller">Best Seller</span>
      {% endif %}
    </div>

    {% if show_quick_add and product.available %}
      <button class="quick-add-btn" 
              data-quick-add="{{ product.id }}"
              aria-label="Quick add {{ product.title | escape }} to cart"
              type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        Quick Add
      </button>
    {% endif %}
  </div>

  <div class="product-card-info">
    {% if section.settings.show_vendor %}
      <span class="product-card-vendor">{{ product.vendor }}</span>
    {% endif %}
    
    <h3 class="product-card-title">{{ product.title }}</h3>
    
    <div class="product-card-price">
      {% if on_sale %}
        <span class="compare-price">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="current-price">{{ product.price | money }}</span>
      {% if product.price_varies %}
        <span class="unit-price">from</span>
      {% endif %}
    </div>

    {% if section.settings.show_rating %}
      <div class="product-card-rating">
        <div class="stars" aria-label="Rating">
          {% assign rating = product.metafields.reviews.rating | default: 4.5 %}
          {% assign full_stars = rating | floor %}
          {% assign has_half = rating | minus: full_stars | round %}
          
          {% for i in (1..5) %}
            {% if i <= full_stars %}
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% elsif i == full_stars and has_half == 1 %}
              <svg viewBox="0 0 24 24" fill="currentColor"><defs><linearGradient id="half-{{ product.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="#ddd"/></linearGradient></defs><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="url(#half-{{ product.id }})"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="#ddd"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endif %}
          {% endfor %}
        </span>
        <span class="review-count">({{ product.metafields.reviews.count | default: 12 }})</span>
      </div>
    {% endif %}
  </div>
</a>

<style>
  .no-image-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    color: #ccc;
    font-size: 0.85rem;
    gap: 8px;
  }
  
  .no-image-placeholder svg {
    opacity: 0.5;
  }
</style>
