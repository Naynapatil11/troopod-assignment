
{%- assign product = product -%}
{%- assign card_style = card_style | default: 'standard' -%}
{%- assign show_quick_add = show_quick_add | default: true -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<a href="{{ product.url }}" 
   class="product-card" 
   role="listitem"
   data-product-id="{{ product.id }}"
   aria-label="{{ product.title }}">
  
  <div class="product-card-image">
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" 
        srcset="{{ product.featured_image | img_url: '400x400' }} 400w,
                {{ product.featured_image | img_url: '600x600' }} 600w"
        sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 25vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="400"
        height="400"
      >
    {% else %}
      <div class="no-image-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1">
          <rect x="3"
