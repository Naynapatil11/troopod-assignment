{%- assign block = block -%}
{%- assign rating = block.settings.rating | default: 5 -%}
{%- assign author_name = block.settings.author_name | default: 'John Doe' -%}
{%- assign review_text = block.settings.review_text | default: 'Amazing products! Highly recommend.' -%}
{%- assign verified = block.settings.verified | default: true -%}
{%- assign has_avatar = block.settings.avatar -%}

<div class="review-slide" role="listitem">
  <div class="review-card" aria-label="Review by {{ author_name | escape }}">
    <div class="review-stars" aria-label="Rating: {{ rating }} out of 5 stars">
      {% for i in (1..5) %}
        {% if i <= rating %}
          <span class="star filled" aria-hidden="true">★</span>
        {% else %}
          <span class="star empty" aria-hidden="true">★</span>
        {% endif %}
      {% endfor %}
    </div>
    
    <p class="review-text">"{{ review_text | escape }}"</p>
    
    <div class="review-author">
      <div class="review-avatar">
        {% if has_avatar %}
          <img src="{{ block.settings.avatar | img_url: '50x50', crop: 'center' }}" 
               alt="{{ author_name | escape }}"
               loading="lazy"
               width="40"
               height="40"
               decoding="async">
        {% else %}
          <div class="avatar-placeholder" aria-hidden="true">{{ author_name | slice: 0 | upcase }}</div>
        {% endif %}
      </div>
      <div class="review-author-info">
        <span class="author-name">{{ author_name }}</span>
        {% if verified %}
          <span class="author-verified" aria-label="Verified buyer">
            ✓ Verified Buyer
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .review-card {
    background: #ffffff;
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }
  
  .review-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }
  
  .review-stars .star {
    font-size: 1.2rem;
  }
  
  .review-stars .star.filled {
    color: #f39c12;
  }
  
  .review-stars .star.empty {
    color: #ddd;
  }
  
  .review-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #1a1a1a;
    margin-bottom: 16px;
    flex: 1;
    font-style: italic;
  }
  
  .review-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  
  .review-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  
  .review-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2d6a4f, #52b788);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
  }
  
  .review-author-info {
    display: flex;
    flex-direction: column;
  }
  
  .author-name {
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .author-verified {
    font-size: 0.8rem;
    color: #2d6a4f;
  }
  
  @media (max-width: 768px) {
    .review-card {
      padding: 24px;
    }
  }
  
  @media (max-width: 480px) {
    .review-card {
      padding: 16px;
    }
    
    .review-text {
      font-size: 0.9rem;
    }
  }
</style>
